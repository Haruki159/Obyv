<Page x:Class="ShoesShop.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoesShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductsPage">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель (поиск и фильтрация) -->
        <WrapPanel Grid.Row="0" Margin="10">
            <TextBox Name="TxtSearch" Width="200" Margin="5" ToolTip="Поиск по названию" TextChanged="FilterChanged"/>

            <ComboBox Name="CmbSort" Width="150" Margin="5" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="Без сортировки"/>
                <ComboBoxItem Content="Склад (возр)"/>
                <ComboBoxItem Content="Склад (убыв)"/>
            </ComboBox>

            <ComboBox Name="CmbManufacturer" Width="180" Margin="5" 
                      DisplayMemberPath="ManufacturerName" SelectionChanged="FilterChanged"/>
        </WrapPanel>

        <!-- Список -->
        <ListView  d:ItemsSource="{d:SampleData ItemCount=5}" Name="LBoxProducts" Grid.Row="1">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="0.5" Margin="5" Background="{Binding ProductBackground}">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <!--Изображение-->
                            <Image Source="{Binding PhotoPath}" Width="150" Height="100" Stretch="Uniform" Grid.RowSpan="4"/>

                            <!--Информация о товаре-->
                            <!-- Привязка к связанной таблице ProductsName -->
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="Наименование: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding NameTovar.NaimenovanieTovara}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="Описание: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding OpisanieTovara}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="Производитель: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding Postavchik.PostavchikName}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1">
                                <TextBlock Text="Цена: "/>
                                <TextBlock Text="{Binding Chena}"/>
                                <TextBlock Text="руб." Margin="5 0 0 0"/>
                            </StackPanel>
                            <!--Скидка (Значение из базы данных)-->
                            <StackPanel Orientation="Horizontal" Grid.Column="2" Grid.Row="1">
                                <TextBlock Grid.Column="2" Text="{Binding DeistvuichaiaSkidka}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
                                <TextBlock Grid.Column="2" Text="%"  FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <Grid Grid.Row="3" Background="#00FA9A">
            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить" Click="Add_Click" Height="25" Width="100" Margin="5"/>
                <Button Content="Удалить" Click="Del_Click"  Height="25" Width="100" Margin="5"/>
                <Button Content="Редактировать" Click="Edit_Click"  Height="25" Width="100" Margin="5"/>
            </StackPanel>
            
        </Grid>
    </Grid>
</Page>
